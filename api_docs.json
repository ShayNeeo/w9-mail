{
  "name": "W9 Mail API",
  "version": "1.0.0",
  "description": "Email service API provider using Microsoft SMTP IMAP POP3",
  "baseUrl": "http://localhost:8080/api",
  "baseUrlNote": "Replace host with your deployed domain (e.g., https://w9.nu/api)",
  "authentication": {
    "type": "Bearer Token (JWT)",
    "header": "Authorization: Bearer <jwt>",
    "note": "Most endpoints require authentication. Obtain a JWT via POST /api/auth/login"
  },
  "endpoints": {
    "health": {
      "GET /health": {
        "method": "GET",
        "path": "/health",
        "description": "Health check endpoint",
        "authentication": false,
        "responses": {
          "200": {
            "description": "Service is healthy",
            "body": "ok"
          }
        }
      }
    },
    "authentication": {
      "POST /api/auth/login": {
        "method": "POST",
        "path": "/api/auth/login",
        "description": "Exchange email + password for a JWT. Required before every other call.",
        "authentication": false,
        "request": {
          "contentType": "application/json",
          "body": {
            "email": "string (required)",
            "password": "string (required)"
          },
          "example": {
            "email": "user@domain.com",
            "password": "string"
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "body": {
              "token": "jwt",
              "role": "user|dev|admin",
              "mustChangePassword": false
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      },
      "POST /api/auth/signup": {
        "method": "POST",
        "path": "/api/auth/signup",
        "description": "Register a normal user and trigger the verification email.",
        "authentication": false,
        "request": {
          "contentType": "application/json",
          "body": {
            "email": "string (required)",
            "password": "string (required, >=8 chars)"
          },
          "example": {
            "email": "user@domain.com",
            "password": "string"
          }
        },
        "responses": {
          "200": {
            "description": "Signup successful, verification email sent",
            "body": {
              "status": "pending",
              "message": "Check your inbox for a verification link."
            }
          },
          "400": {
            "description": "Invalid request or email already exists"
          }
        }
      },
      "POST /api/auth/signup/verify": {
        "method": "POST",
        "path": "/api/auth/signup/verify",
        "description": "Confirm the token emailed during signup.",
        "authentication": false,
        "request": {
          "contentType": "application/json",
          "body": {
            "token": "string (required, uuid-from-email)"
          },
          "example": {
            "token": "uuid-from-email"
          }
        },
        "responses": {
          "200": {
            "description": "Account verified",
            "body": {
              "status": "verified",
              "message": "Account verified. You can sign in now."
            }
          },
          "400": {
            "description": "Invalid or expired token"
          }
        }
      },
      "POST /api/auth/password-reset": {
        "method": "POST",
        "path": "/api/auth/password-reset",
        "description": "Send a reset link via the default sender. Hides whether the email exists.",
        "authentication": false,
        "request": {
          "contentType": "application/json",
          "body": {
            "email": "string (required)"
          },
          "example": {
            "email": "user@domain.com"
          }
        },
        "responses": {
          "200": {
            "description": "Reset link sent (if email exists)",
            "body": {
              "status": "ok",
              "message": "If the email exists, a reset link was sent."
            }
          }
        }
      },
      "POST /api/auth/password-reset/confirm": {
        "method": "POST",
        "path": "/api/auth/password-reset/confirm",
        "description": "Consume the reset token and set a new password.",
        "authentication": false,
        "request": {
          "contentType": "application/json",
          "body": {
            "token": "string (required, uuid)",
            "newPassword": "string (required, >=8 chars)"
          },
          "example": {
            "token": "uuid",
            "newPassword": "string"
          }
        },
        "responses": {
          "200": {
            "description": "Password updated",
            "body": {
              "status": "success",
              "message": "Password updated. You can sign in now."
            }
          },
          "400": {
            "description": "Invalid or expired token"
          }
        }
      },
      "POST /api/auth/change-password": {
        "method": "POST",
        "path": "/api/auth/change-password",
        "description": "Change password for authenticated user. Forces default admin to rotate secrets on first login.",
        "authentication": true,
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <jwt>"
          },
          "body": {
            "currentPassword": "string (required)",
            "newPassword": "string (required, >=8 chars)"
          },
          "example": {
            "currentPassword": "string",
            "newPassword": "string"
          }
        },
        "responses": {
          "200": {
            "description": "Password updated",
            "body": {
              "status": "success",
              "message": "Password updated"
            }
          },
          "401": {
            "description": "Invalid current password"
          },
          "403": {
            "description": "Must change password first"
          }
        }
      },
      "GET /api/auth/me": {
        "method": "GET",
        "path": "/api/auth/me",
        "description": "Get current authenticated user information",
        "authentication": true,
        "request": {
          "headers": {
            "Authorization": "Bearer <jwt>"
          }
        },
        "responses": {
          "200": {
            "description": "User information",
            "body": {
              "id": "uuid",
              "email": "string",
              "role": "admin|dev|user",
              "mustChangePassword": false
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "users": {
      "GET /api/users": {
        "method": "GET",
        "path": "/api/users",
        "description": "Admin-only snapshot of every auth profile",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          }
        },
        "responses": {
          "200": {
            "description": "List of all users",
            "body": [
              {
                "id": "uuid",
                "email": "string",
                "role": "admin|dev|user",
                "mustChangePassword": false
              }
            ]
          },
          "403": {
            "description": "Forbidden - admin role required"
          }
        }
      },
      "POST /api/users": {
        "method": "POST",
        "path": "/api/users",
        "description": "Admin-only invite. Defaults to creating a normal user.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "body": {
            "email": "string (required)",
            "password": "string (required, >=8 chars)",
            "role": "admin|dev|user (optional, defaults to 'user')"
          },
          "example": {
            "email": "user@domain.com",
            "password": "string",
            "role": "user"
          }
        },
        "responses": {
          "200": {
            "description": "User created",
            "body": {
              "id": "uuid",
              "email": "string",
              "role": "admin|dev|user",
              "mustChangePassword": false
            }
          },
          "400": {
            "description": "Invalid request or password too short"
          },
          "403": {
            "description": "Forbidden - admin role required"
          }
        }
      },
      "PATCH /api/users/:id": {
        "method": "PATCH",
        "path": "/api/users/:id",
        "description": "Admin-only mutation for rotating roles, changing passwords, or forcing password resets.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "pathParameters": {
            "id": "string (required, user uuid)"
          },
          "body": {
            "password": "string (optional, >=8 chars)",
            "role": "admin|dev|user (optional)",
            "mustChangePassword": "boolean (optional)"
          },
          "example": {
            "password": "optional string",
            "role": "dev",
            "mustChangePassword": true
          }
        },
        "responses": {
          "200": {
            "description": "User updated",
            "body": {
              "id": "uuid",
              "email": "string",
              "role": "admin|dev|user",
              "mustChangePassword": false
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "DELETE /api/users/:id": {
        "method": "DELETE",
        "path": "/api/users/:id",
        "description": "Admin-only removal. Backend blocks deleting the currently authenticated admin.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "pathParameters": {
            "id": "string (required, user uuid)"
          }
        },
        "responses": {
          "204": {
            "description": "User deleted successfully"
          },
          "400": {
            "description": "Cannot delete yourself"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "accounts": {
      "GET /api/accounts": {
        "method": "GET",
        "path": "/api/accounts",
        "description": "List all sender profiles (auth required). Normal users only see status, admins can mutate.",
        "authentication": true,
        "request": {
          "headers": {
            "Authorization": "Bearer <jwt>"
          }
        },
        "responses": {
          "200": {
            "description": "List of accounts",
            "body": [
              {
                "id": "uuid",
                "email": "string",
                "displayName": "string",
                "isActive": true
              }
            ]
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "POST /api/accounts": {
        "method": "POST",
        "path": "/api/accounts",
        "description": "Create a new sender (stores password for SMTP authentication).",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "body": {
            "email": "string (required)",
            "displayName": "string (required)",
            "password": "string (required)",
            "isActive": "boolean (required)"
          },
          "example": {
            "email": "sender@domain.com",
            "displayName": "Ops Bot",
            "password": "string",
            "isActive": true
          }
        },
        "responses": {
          "200": {
            "description": "Account created",
            "body": {
              "status": "success",
              "message": "Account created successfully",
              "account": {
                "id": "uuid",
                "email": "string",
                "displayName": "string",
                "isActive": true
              }
            }
          },
          "400": {
            "description": "Invalid request or email already exists"
          },
          "403": {
            "description": "Forbidden - admin role required"
          }
        }
      },
      "PATCH /api/accounts/:id": {
        "method": "PATCH",
        "path": "/api/accounts/:id",
        "description": "Toggle activation and/or rotate password.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "pathParameters": {
            "id": "string (required, account uuid)"
          },
          "body": {
            "isActive": "boolean (optional)",
            "password": "string (optional)"
          },
          "example": {
            "isActive": true,
            "password": "new-password"
          }
        },
        "responses": {
          "200": {
            "description": "Account updated",
            "body": {
              "id": "uuid",
              "email": "string",
              "displayName": "string",
              "isActive": true
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "Account not found"
          }
        }
      },
      "DELETE /api/accounts/:id": {
        "method": "DELETE",
        "path": "/api/accounts/:id",
        "description": "Delete an account. Also clears default sender if it matches.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "pathParameters": {
            "id": "string (required, account uuid)"
          }
        },
        "responses": {
          "204": {
            "description": "Account deleted successfully"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    },
    "aliases": {
      "GET /api/aliases": {
        "method": "GET",
        "path": "/api/aliases",
        "description": "List all email aliases",
        "authentication": true,
        "request": {
          "headers": {
            "Authorization": "Bearer <jwt>"
          }
        },
        "responses": {
          "200": {
            "description": "List of aliases",
            "body": [
              {
                "id": "uuid",
                "aliasEmail": "string",
                "displayName": "string|null",
                "isActive": true,
                "accountId": "uuid",
                "accountEmail": "string",
                "accountDisplayName": "string",
                "accountIsActive": true
              }
            ]
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "POST /api/aliases": {
        "method": "POST",
        "path": "/api/aliases",
        "description": "Create a new email alias",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "body": {
            "accountId": "string (required, uuid)",
            "aliasEmail": "string (required)",
            "displayName": "string (optional)",
            "isActive": "boolean (required)"
          },
          "example": {
            "accountId": "uuid",
            "aliasEmail": "alias@domain.com",
            "displayName": "Marketing Bot",
            "isActive": true
          }
        },
        "responses": {
          "200": {
            "description": "Alias created",
            "body": {
              "id": "uuid",
              "aliasEmail": "string",
              "displayName": "string|null",
              "isActive": true,
              "accountId": "uuid",
              "accountEmail": "string",
              "accountDisplayName": "string",
              "accountIsActive": true
            }
          },
          "400": {
            "description": "Invalid request or account not found"
          },
          "409": {
            "description": "Alias email already exists"
          },
          "403": {
            "description": "Forbidden - admin role required"
          }
        }
      },
      "PATCH /api/aliases/:id": {
        "method": "PATCH",
        "path": "/api/aliases/:id",
        "description": "Update an alias (account, display name, or activation status)",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "pathParameters": {
            "id": "string (required, alias uuid)"
          },
          "body": {
            "accountId": "string (optional, uuid)",
            "displayName": "string (optional)",
            "isActive": "boolean (optional)"
          },
          "example": {
            "accountId": "uuid",
            "displayName": "Updated Name",
            "isActive": false
          }
        },
        "responses": {
          "200": {
            "description": "Alias updated",
            "body": {
              "id": "uuid",
              "aliasEmail": "string",
              "displayName": "string|null",
              "isActive": true,
              "accountId": "uuid",
              "accountEmail": "string",
              "accountDisplayName": "string",
              "accountIsActive": true
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "Alias not found"
          }
        }
      },
      "DELETE /api/aliases/:id": {
        "method": "DELETE",
        "path": "/api/aliases/:id",
        "description": "Delete an alias. Also clears default sender if it matches.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "pathParameters": {
            "id": "string (required, alias uuid)"
          }
        },
        "responses": {
          "204": {
            "description": "Alias deleted successfully"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "Alias not found"
          }
        }
      }
    },
    "email": {
      "POST /api/send": {
        "method": "POST",
        "path": "/api/send",
        "description": "Send email using any registered account or alias. Available to user, dev, and admin roles. The 'from' address must match a registered account email or alias email that is active.",
        "authentication": true,
        "requiredRole": "user|dev|admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <user|dev|admin jwt>"
          },
          "body": {
            "from": "string (required, account or alias email)",
            "to": "string (required, comma-separated for multiple)",
            "subject": "string (required)",
            "body": "string (required)",
            "cc": "string (optional, comma-separated)",
            "bcc": "string (optional, comma-separated)",
            "isHtml": "boolean (optional, defaults to false)"
          },
          "example": {
            "from": "sender@domain.com",
            "to": "to@domain.com",
            "subject": "Test Email",
            "body": "Email body content",
            "cc": "cc1@domain.com, cc2@domain.com",
            "bcc": "bcc@domain.com",
            "isHtml": false
          },
          "notes": [
            "The 'from' field accepts either a base account email or an alias email. Aliases will send via their associated account credentials.",
            "Set 'isHtml' to true to send HTML-formatted emails. When false or omitted, emails are sent as plain text.",
            "Multiple recipients in 'to', 'cc', or 'bcc' should be comma-separated.",
            "The sender account or alias must be active for the email to be sent."
          ]
        },
        "responses": {
          "200": {
            "description": "Email sent successfully",
            "body": {
              "status": "sent",
              "message": "Email sent successfully"
            }
          },
          "200_error": {
            "description": "Email sending failed",
            "body": {
              "status": "error",
              "message": "Sender account or alias not found or inactive"
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - must change password first or invalid role"
          }
        }
      },
      "GET /api/inbox": {
        "method": "GET",
        "path": "/api/inbox",
        "description": "IMAP bridge (placeholder for future work)",
        "authentication": true,
        "request": {
          "headers": {
            "Authorization": "Bearer <jwt>"
          },
          "queryParameters": {
            "account": "string (required)",
            "limit": "number (optional, default: 50)"
          }
        },
        "responses": {
          "200": {
            "description": "Empty array (not yet implemented)",
            "body": []
          }
        }
      }
    },
    "settings": {
      "GET /api/settings/default-sender": {
        "method": "GET",
        "path": "/api/settings/default-sender",
        "description": "Admin-only snapshot of the automatic sender used for signup and reset emails.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          }
        },
        "responses": {
          "200": {
            "description": "Default sender information",
            "body": {
              "senderType": "account|alias",
              "senderId": "uuid",
              "email": "string",
              "displayLabel": "string",
              "viaDisplay": "string|null",
              "isActive": true
            }
          },
          "200_null": {
            "description": "No default sender set",
            "body": null
          },
          "403": {
            "description": "Forbidden - admin role required"
          }
        }
      },
      "PUT /api/settings/default-sender": {
        "method": "PUT",
        "path": "/api/settings/default-sender",
        "description": "Admin-only setter. Only active accounts or aliases are accepted.",
        "authentication": true,
        "requiredRole": "admin",
        "request": {
          "contentType": "application/json",
          "headers": {
            "Authorization": "Bearer <admin jwt>"
          },
          "body": {
            "senderType": "account|alias (required)",
            "senderId": "string (required, uuid)"
          },
          "example": {
            "senderType": "alias",
            "senderId": "uuid"
          }
        },
        "responses": {
          "200": {
            "description": "Default sender updated",
            "body": {
              "senderType": "account|alias",
              "senderId": "uuid",
              "email": "string",
              "displayLabel": "string",
              "viaDisplay": "string|null",
              "isActive": true
            }
          },
          "400": {
            "description": "Invalid request or sender not found/inactive"
          },
          "403": {
            "description": "Forbidden - admin role required"
          }
        }
      }
    }
  },
  "errorCodes": {
    "400": "Bad Request - Invalid request parameters",
    "401": "Unauthorized - Missing or invalid authentication token",
    "403": "Forbidden - Insufficient permissions or must change password first",
    "404": "Not Found - Resource not found",
    "409": "Conflict - Resource already exists",
    "500": "Internal Server Error - Server error occurred"
  },
  "notes": {
    "authentication": "Most endpoints require a JWT token obtained via POST /api/auth/login. Include it in the Authorization header as 'Bearer <token>'.",
    "roles": {
      "admin": "Full access to all endpoints including user management, account/alias management, and settings",
      "dev": "Can send emails and access most endpoints, but cannot manage users or system settings",
      "user": "Can send emails and view accounts/aliases, but cannot modify them"
    },
    "passwordRequirements": "Passwords must be at least 8 characters long",
    "emailSending": {
      "accounts": "Base accounts are direct Microsoft email accounts with SMTP credentials",
      "aliases": "Aliases are email addresses that send via an associated account's credentials",
      "htmlSupport": "Set 'isHtml' to true in the request body to send HTML-formatted emails. The API preserves HTML content as-is when this flag is set."
    },
    "defaultSender": "The default sender is used for system emails (signup verification, password resets). It must be an active account or alias."
  }
}

