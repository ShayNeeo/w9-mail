# W9 Mail environment configuration
# Copy this file to .env and fill in the values

# Server
HOST=0.0.0.0
PORT=8080
BASE_URL=https://mail.w9.nu

# Database
DATABASE_URL=memory

# JWT authentication
JWT_SECRET=change-me-in-production

# w9-db OAuth provider
ISSUER_URL=https://db.w9.nu
W9_DB_API_URL=https://db.w9.nu

# SMTP settings (Outlook)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USERNAME=your-email@outlook.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=starttls
DEFAULT_FROM=W9 Mail <your-email@outlook.com>
